# ==== Supabase ====
# Dashboard > Connect > "Session pooler" (khuyên dùng; kết nối trực tiếp db.<ref>.supabase.co chỉ có IPv6).
# Mật khẩu có ký tự đặc biệt (@ : / # ?) phải mã hóa URL, VD @ -> %40
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<MAT_KHAU>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
